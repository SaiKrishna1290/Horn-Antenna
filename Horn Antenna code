%% ========================================================================
% 56. TWO-STAGE ADAPTIVE OPTIMIZATION
% =========================================================================

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('              TWO-STAGE ADAPTIVE OPTIMIZATION\n');
fprintf('=====================================================================\n');

adaptiveTimer = tic;

%% ------------------------------------------------------------------------
% STAGE 1 - COARSE SEARCH
% -------------------------------------------------------------------------

coarseWidth  = 0.08:0.01:0.12;
coarseHeight = 0.05:0.01:0.09;
coarseLength = 0.10:0.02:0.20;

[nW,nH,nL] = deal( ...
    numel(coarseWidth), ...
    numel(coarseHeight), ...
    numel(coarseLength));

coarseCount = nW*nH*nL;

fprintf('\nCoarse search designs : %d\n',coarseCount);

%% Generate combinations

[CW,CH,CL] = ndgrid( ...
    coarseWidth,...
    coarseHeight,...
    coarseLength);

CW = CW(:);
CH = CH(:);
CL = CL(:);

%% Preallocate

coarseS11  = NaN(coarseCount,1);
coarseVSWR = NaN(coarseCount,1);

%% ------------------------------------------------------------------------
% COARSE S11 SCREENING
% -------------------------------------------------------------------------

fprintf('Running coarse S11 screening...\n');

for k = 1:coarseCount

    testHorn = horn;

    testHorn.FlareWidth  = CW(k);
    testHorn.FlareHeight = CH(k);
    testHorn.Length      = CL(k);

    try

        tempS = sparameters(testHorn,f0);

        tempS11 = ...
            squeeze(tempS.Parameters(1,1));

        coarseS11(k) = ...
            20*log10(abs(tempS11));

        gamma = abs(tempS11);

        if gamma < 1

            coarseVSWR(k) = ...
                (1+gamma)/(1-gamma);

        end

    catch

        coarseS11(k) = NaN;
        coarseVSWR(k) = NaN;

    end

end

%% ------------------------------------------------------------------------
% REMOVE INVALID RESULTS
% -------------------------------------------------------------------------

valid = ...
    ~isnan(coarseS11) & ...
    ~isnan(coarseVSWR);

CW = CW(valid);
CH = CH(valid);
CL = CL(valid);

coarseS11  = coarseS11(valid);
coarseVSWR = coarseVSWR(valid);

%% ------------------------------------------------------------------------
% COARSE SCORE
% -------------------------------------------------------------------------

coarseScore = zeros(size(coarseS11));

%% S11 contribution

coarseScore = coarseScore + ...
    max(0,min(40, ...
    (-coarseS11)*3));

%% VSWR contribution

coarseScore = coarseScore + ...
    max(0,min(30, ...
    30 - 10*(coarseVSWR-1)));

%% Physical-size contribution

physicalPenalty = ...
    (CW/0.10 + ...
     CH/0.07 + ...
     CL/0.15);

coarseScore = ...
    coarseScore + ...
    max(0,30 - ...
    5*abs(physicalPenalty-3));

%% ------------------------------------------------------------------------
% SELECT TOP DESIGNS
% -------------------------------------------------------------------------

[~,rankIndex] = ...
    sort(coarseScore,'descend');

topCoarse = ...
    min(10,length(rankIndex));

selectedIndex = ...
    rankIndex(1:topCoarse);

fprintf('\nTop coarse candidates: %d\n',topCoarse);

%% ========================================================================
% 57. STAGE 2 - FINE SEARCH AROUND TOP DESIGNS
% =========================================================================

fprintf('\nStarting fine optimization...\n');

fineResults = [];

for n = 1:topCoarse

    baseIndex = selectedIndex(n);

    baseW = CW(baseIndex);
    baseH = CH(baseIndex);
    baseL = CL(baseIndex);

    %% Fine ranges

    fineWidth = ...
        max(0.06,baseW-0.01):0.002:...
        min(0.14,baseW+0.01);

    fineHeight = ...
        max(0.04,baseH-0.01):0.002:...
        min(0.11,baseH+0.01);

    fineLength = ...
        max(0.08,baseL-0.02):0.005:...
        min(0.25,baseL+0.02);

    [FW,FH,FL] = ndgrid( ...
        fineWidth,...
        fineHeight,...
        fineLength);

    FW = FW(:);
    FH = FH(:);
    FL = FL(:);

    localCount = numel(FW);

    fprintf( ...
        'Refining candidate %d/%d : %d designs\n',...
        n,topCoarse,localCount);

    for k = 1:localCount

        testHorn = horn;

        testHorn.FlareWidth  = FW(k);
        testHorn.FlareHeight = FH(k);
        testHorn.Length      = FL(k);

        try

            tempS = ...
                sparameters(testHorn,f0);

            tempS11 = ...
                squeeze(tempS.Parameters(1,1));

            s11 = ...
                20*log10(abs(tempS11));

            gamma = abs(tempS11);

            if gamma < 1

                vswr = ...
                    (1+gamma)/(1-gamma);

            else

                vswr = Inf;

            end

        catch

            s11 = NaN;
            vswr = NaN;

        end

        if isnan(s11)

            continue;

        end

        %% Only perform expensive analysis on promising designs

        if s11 > -6

            continue;

        end

        %% Directivity

        try

            directivity = ...
                pattern( ...
                testHorn,...
                f0,...
                0,...
                0,...
                'Type','directivity');

        catch

            directivity = NaN;

        end

        %% Gain

        try

            gain = ...
                pattern( ...
                testHorn,...
                f0,...
                0,...
                0,...
                'Type','gain');

        catch

            gain = NaN;

        end

        %% Combined score

        if isnan(directivity) || isnan(gain)

            continue;

        end

        score = 0;

        %% S11

        score = score + ...
            min(40,max(0,-2*s11));

        %% VSWR

        score = score + ...
            min(20,max(0,20-10*(vswr-1)));

        %% Directivity

        score = score + ...
            min(25,max(0,directivity));

        %% Gain

        score = score + ...
            min(15,max(0,gain));

        %% Store

        fineResults = [
            fineResults;
            FW(k) ...
            FH(k) ...
            FL(k) ...
            s11 ...
            vswr ...
            gain ...
            directivity ...
            score
            ];

    end

end

%% ========================================================================
% 58. FINAL OPTIMIZATION TABLE
% =========================================================================

if isempty(fineResults)

    warning( ...
        'No fine-search candidate passed the S11 threshold.');

else

    finalTable = table( ...
        fineResults(:,1),...
        fineResults(:,2),...
        fineResults(:,3),...
        fineResults(:,4),...
        fineResults(:,5),...
        fineResults(:,6),...
        fineResults(:,7),...
        fineResults(:,8),...
        'VariableNames',...
        { ...
        'Width_m',...
        'Height_m',...
        'Length_m',...
        'S11_dB',...
        'VSWR',...
        'Gain_dBi',...
        'Directivity_dBi',...
        'Score' ...
        });

    %% Sort

    finalTable = ...
        sortrows( ...
        finalTable,...
        'Score',...
        'descend');

    %% Best design

    finalBest = ...
        finalTable(1,:);

    fprintf('\n');
    fprintf('=====================================================================\n');
    fprintf('                    FINAL OPTIMIZED DESIGN\n');
    fprintf('=====================================================================\n');

    fprintf('\nWidth       : %.3f cm\n',...
        finalBest.Width_m*100);

    fprintf('Height      : %.3f cm\n',...
        finalBest.Height_m*100);

    fprintf('Length      : %.3f cm\n',...
        finalBest.Length_m*100);

    fprintf('S11         : %.3f dB\n',...
        finalBest.S11_dB);

    fprintf('VSWR        : %.3f\n',...
        finalBest.VSWR);

    fprintf('Gain        : %.3f dBi\n',...
        finalBest.Gain_dBi);

    fprintf('Directivity : %.3f dBi\n',...
        finalBest.Directivity_dBi);

    fprintf('Score       : %.2f / 100\n',...
        finalBest.Score);

    %% Save

    writetable( ...
        finalTable,...
        fullfile( ...
        resultFolder,...
        'Final_Optimized_Designs.csv'));

end

%% ========================================================================
% 59. CREATE FINAL ANTENNA
% =========================================================================

if ~isempty(fineResults)

    finalHorn = horn;

    finalHorn.FlareWidth = ...
        finalBest.Width_m;

    finalHorn.FlareHeight = ...
        finalBest.Height_m;

    finalHorn.Length = ...
        finalBest.Length_m;

    %% Geometry

    figure( ...
        'Name','Final Optimized Horn',...
        'NumberTitle','off');

    show(finalHorn);

    title('Final Optimized Rectangular Horn');

    saveas( ...
        gcf,...
        fullfile( ...
        resultFolder,...
        'Final_Optimized_Geometry.png'));

    %% Radiation pattern

    figure( ...
        'Name','Final Optimized Pattern',...
        'NumberTitle','off');

    pattern(finalHorn,f0);

    title('Final Optimized Radiation Pattern - 10 GHz');

    saveas( ...
        gcf,...
        fullfile( ...
        resultFolder,...
        'Final_Optimized_Pattern.png'));

end

%% ========================================================================
% 60. FINAL OPTIMIZATION TIME
% =========================================================================

adaptiveTime = ...
    toc(adaptiveTimer);

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('             ADAPTIVE OPTIMIZATION COMPLETE\n');
fprintf('=====================================================================\n');

fprintf('Coarse Designs      : %d\n',coarseCount);

fprintf('Fine Candidates     : %d\n',topCoarse);

fprintf('Execution Time      : %.2f seconds\n',adaptiveTime);

fprintf('=====================================================================\n');
