%% ==========================================================
% RECTANGULAR HORN ANTENNA DESIGN & ANALYSIS
% MATLAB Antenna Toolbox
% Author : Sai Krishna
% ==========================================================

clc;
clear;
close all;

tic;                        % Start timer

%% -----------------------------
% Simulation Parameters
%% -----------------------------
c = physconst('LightSpeed');
f0 = 10e9;                  % Operating frequency
freqStart = 8e9;
freqStop  = 12e9;
numPoints = 75;

lambda = c/f0;

fprintf('\n============================================\n');
fprintf(' RECTANGULAR HORN ANTENNA SIMULATION\n');
fprintf('============================================\n');
fprintf('Operating Frequency : %.2f GHz\n',f0/1e9);
fprintf('Wavelength          : %.2f mm\n',lambda*1000);

%% -----------------------------
% Horn Dimensions
%% -----------------------------
flareWidth  = 0.10;
flareHeight = 0.07;
hornLength  = 0.15;

%% -----------------------------
% Create Horn Antenna
%% -----------------------------
myHorn = horn;

myHorn.FlareWidth  = flareWidth;
myHorn.FlareHeight = flareHeight;
myHorn.Length      = hornLength;

fprintf('\nHorn Parameters\n');
fprintf('-----------------------------\n');
fprintf('Flare Width  : %.2f cm\n',flareWidth*100);
fprintf('Flare Height : %.2f cm\n',flareHeight*100);
fprintf('Length       : %.2f cm\n',hornLength*100);

%% -----------------------------
% Geometry
%% -----------------------------
figure('Name','Horn Geometry');
show(myHorn);
title('Rectangular Horn Antenna');

%% -----------------------------
% Radiation Pattern
%% -----------------------------
figure('Name','Radiation Pattern');
pattern(myHorn,f0);
title(sprintf('Radiation Pattern at %.1f GHz',f0/1e9));

%% -----------------------------
% Frequency Sweep
%% -----------------------------
freqRange = linspace(freqStart,freqStop,numPoints);

try

    %% Calculate S Parameters
    S = sparameters(myHorn,freqRange);

    %% Extract S11
    S11 = squeeze(S.Parameters(1,1,:));
    S11dB = 20*log10(abs(S11));

    %% Resonant Frequency
    [minS11,index] = min(S11dB);
    resonantFreq = freqRange(index);

    %% -------------------------
    % RF Plot
    %% -------------------------
    figure('Name','RF Plot');
    rfplot(S);

    grid on;
    title('S11 (Return Loss)');

    %% -------------------------
    % Custom S11
    %% -------------------------
    figure('Name','S11');

    plot(freqRange/1e9,S11dB,...
        'LineWidth',2);

    hold on;

    yline(-10,'r--','-10 dB');

    plot(resonantFreq/1e9,minS11,...
        'ko','MarkerFaceColor','red');

    text(resonantFreq/1e9,...
        minS11,...
        sprintf('  %.2f GHz',resonantFreq/1e9));

    grid on;

    xlabel('Frequency (GHz)');
    ylabel('S_{11} (dB)');
    title('Return Loss');
    legend('S11','-10 dB','Resonance');

    %% -------------------------
    % VSWR
    %% -------------------------
    Gamma = abs(S11);
    VSWR = (1+Gamma)./(1-Gamma);

    figure('Name','VSWR');

    plot(freqRange/1e9,VSWR,...
        'LineWidth',2);

    grid on;

    xlabel('Frequency (GHz)');
    ylabel('VSWR');

    title('Voltage Standing Wave Ratio');

    %% -------------------------
    % Impedance
    %% -------------------------
    figure('Name','Input Impedance');
    impedance(myHorn,freqRange);

    %% -------------------------
    % Current Distribution
    %% -------------------------
    figure('Name','Surface Current');
    current(myHorn,f0);

catch ME

    fprintf('\nSimulation Error\n');
    fprintf('%s\n',ME.message);

end

%% -----------------------------
% Reflector Antenna
%% -----------------------------
myDish = reflector;

myDish.Exciter = myHorn;
myDish.GroundPlaneRadius = 0.5;

figure('Name','Reflector Geometry');
show(myDish);

title('Horn Fed Reflector');

%% Radiation Pattern of Reflector
figure('Name','Reflector Pattern');
pattern(myDish,f0);

%% -----------------------------
% Simulation Summary
%% -----------------------------
fprintf('\n=====================================\n');
fprintf('Simulation Summary\n');
fprintf('=====================================\n');

fprintf('Operating Frequency : %.2f GHz\n',f0/1e9);
fprintf('Frequency Sweep     : %.1f - %.1f GHz\n',...
    freqStart/1e9,freqStop/1e9);

fprintf('Minimum S11         : %.2f dB\n',minS11);
fprintf('Resonant Frequency  : %.3f GHz\n',...
    resonantFreq/1e9);

fprintf('Total Frequency Points : %d\n',numPoints);

executionTime=toc;

fprintf('Execution Time : %.2f seconds\n',executionTime);

fprintf('\nSimulation Completed Successfully.\n');
Directivity=zeros(length(freqRange),1);

for k=1:length(freqRange)

    Directivity(k)=pattern(myHorn,...
        freqRange(k),...
        0,90,...
        'Type','directivity');

end

figure;

plot(freqRange/1e9,...
    Directivity,...
    'LineWidth',2);

grid on;

xlabel('Frequency (GHz)');
ylabel('Directivity (dBi)');

title('Directivity vs Frequency');

saveas(gcf,...
fullfile(outputFolder,'Directivity.png'));
Gain=zeros(length(freqRange),1);

for k=1:length(freqRange)

    Gain(k)=pattern(myHorn,...
        freqRange(k),0,90,...
        'Type','gain');

end

figure;

plot(freqRange/1e9,...
    Gain,...
    'LineWidth',2);

grid on;

xlabel('Frequency (GHz)');
ylabel('Gain (dBi)');

title('Gain vs Frequency');

saveas(gcf,...
fullfile(outputFolder,'Gain.png'));
figure('Name','Smith Chart');

smithplot(S,1,1);

title('Horn Antenna Smith Chart');

saveas(gcf,...
fullfile(outputFolder,'SmithChart.png'));
figure;

pattern(myHorn,...
    f0,...
    -180:180,...
    0);

title('H Plane Radiation Pattern');

saveas(gcf,...
fullfile(outputFolder,'HPlane.png'));
BW=beamwidth(myHorn,f0);

fprintf('\nBeamwidth = %.2f Degrees\n',BW);
