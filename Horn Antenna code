%% ========================================================================
% 33. MONTE-CARLO MANUFACTURING TOLERANCE ANALYSIS
% =========================================================================

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('           MONTE-CARLO ROBUSTNESS ANALYSIS\n');
fprintf('=====================================================================\n');

monteCarloTimer = tic;

%% Number of random samples

numMonteCarlo = 50;

%% Manufacturing tolerance

tolerance = 0.02;       % ±2%

fprintf('\nMonte-Carlo samples : %d\n',numMonteCarlo);
fprintf('Dimensional tolerance : ±%.1f %%\n',...
    tolerance*100);

%% Frequency for robustness test

mcFrequency = f0;

%% Preallocate

mcWidth = NaN(numMonteCarlo,1);
mcHeight = NaN(numMonteCarlo,1);
mcLength = NaN(numMonteCarlo,1);

mcS11 = NaN(numMonteCarlo,1);
mcVSWR = NaN(numMonteCarlo,1);

%% Random seed for reproducibility

rng(25,'twister');

%% Random dimensional variations

mcWidth = ...
    bestDesign.FlareWidth_m .* ...
    (1 + tolerance*(2*rand(numMonteCarlo,1)-1));

mcHeight = ...
    bestDesign.FlareHeight_m .* ...
    (1 + tolerance*(2*rand(numMonteCarlo,1)-1));

mcLength = ...
    bestDesign.HornLength_m .* ...
    (1 + tolerance*(2*rand(numMonteCarlo,1)-1));

%% ========================================================================
% RUN MONTE-CARLO EM SIMULATIONS
% =========================================================================

fprintf('\nRunning tolerance simulations...\n');

if parallelAvailable

    parfor k = 1:numMonteCarlo

        testHorn = horn;

        testHorn.FlareWidth = mcWidth(k);
        testHorn.FlareHeight = mcHeight(k);
        testHorn.Length = mcLength(k);

        try

            tempS = ...
                sparameters(testHorn,mcFrequency);

            gamma = ...
                abs(tempS.Parameters(1,1));

            mcS11(k) = ...
                20*log10(gamma);

            if gamma < 1

                mcVSWR(k) = ...
                    (1+gamma)/(1-gamma);

            end

        catch

            mcS11(k) = NaN;
            mcVSWR(k) = NaN;

        end

    end

else

    for k = 1:numMonteCarlo

        testHorn = horn;

        testHorn.FlareWidth = mcWidth(k);
        testHorn.FlareHeight = mcHeight(k);
        testHorn.Length = mcLength(k);

        try

            tempS = ...
                sparameters(testHorn,mcFrequency);

            gamma = ...
                abs(tempS.Parameters(1,1));

            mcS11(k) = ...
                20*log10(gamma);

            if gamma < 1

                mcVSWR(k) = ...
                    (1+gamma)/(1-gamma);

            end

        catch

            mcS11(k) = NaN;
            mcVSWR(k) = NaN;

        end

    end

end

%% ========================================================================
% REMOVE INVALID RESULTS
% =========================================================================

validMC = ...
    isfinite(mcS11) & ...
    isfinite(mcVSWR);

validS11 = ...
    mcS11(validMC);

validVSWR = ...
    mcVSWR(validMC);

%% ========================================================================
% STATISTICS
% =========================================================================

meanS11 = mean(validS11);
stdS11 = std(validS11);

worstS11 = max(validS11);
bestS11 = min(validS11);

meanVSWR = mean(validVSWR);
stdVSWR = std(validVSWR);

worstVSWR = max(validVSWR);
bestVSWR = min(validVSWR);

%% ========================================================================
% ROBUSTNESS PERCENTAGE
% =========================================================================

s11Success = ...
    validS11 <= -10;

vswrSuccess = ...
    validVSWR <= 2;

s11Robustness = ...
    mean(s11Success)*100;

vswrRobustness = ...
    mean(vswrSuccess)*100;

%% ========================================================================
% DISPLAY RESULTS
% =========================================================================

fprintf('\n');
fprintf('Monte-Carlo Results\n');
fprintf('-------------------------------------\n');

fprintf('Valid simulations : %d / %d\n',...
    sum(validMC),numMonteCarlo);

fprintf('\nS11 Statistics\n');

fprintf('Mean S11     : %.3f dB\n',meanS11);
fprintf('Std. Dev.    : %.3f dB\n',stdS11);
fprintf('Best S11     : %.3f dB\n',bestS11);
fprintf('Worst S11    : %.3f dB\n',worstS11);

fprintf('\nVSWR Statistics\n');

fprintf('Mean VSWR    : %.3f\n',meanVSWR);
fprintf('Std. Dev.    : %.3f\n',stdVSWR);
fprintf('Best VSWR    : %.3f\n',bestVSWR);
fprintf('Worst VSWR   : %.3f\n',worstVSWR);

fprintf('\nRobustness\n');

fprintf('S11 <= -10 dB : %.1f %%\n',...
    s11Robustness);

fprintf('VSWR <= 2      : %.1f %%\n',...
    vswrRobustness);

fprintf('\nMonte-Carlo time : %.2f seconds\n',...
    toc(monteCarloTimer));
