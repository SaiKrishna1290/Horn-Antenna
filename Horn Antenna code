%% ========================================================================
% 8A. SURROGATE MODEL RELIABILITY VALIDATION
% =========================================================================

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('             SURROGATE MODEL RELIABILITY CHECK\n');
fprintf('=====================================================================\n');

%% ------------------------------------------------------------------------
% 1. TRAINING PREDICTION
% -------------------------------------------------------------------------

predictedTraining = A * beta;

%% Prediction errors

predictionError = ...
    Y - predictedTraining;

RMSE = ...
    sqrt(mean(predictionError.^2));

MAE = ...
    mean(abs(predictionError));

%% R-squared

SST = ...
    sum((Y-mean(Y)).^2);

SSE = ...
    sum(predictionError.^2);

if SST > 0

    R2 = ...
        1 - SSE/SST;

else

    R2 = NaN;

end

%% Maximum error

maxError = ...
    max(abs(predictionError));

%% ------------------------------------------------------------------------
% DISPLAY MODEL QUALITY
% -------------------------------------------------------------------------

fprintf('\nSurrogate Model Quality\n');
fprintf('-------------------------------------\n');

fprintf('RMSE          : %.4f dB\n',RMSE);
fprintf('MAE           : %.4f dB\n',MAE);
fprintf('Maximum Error : %.4f dB\n',maxError);
fprintf('R^2           : %.4f\n',R2);

%% ------------------------------------------------------------------------
% MODEL ACCEPTANCE
% -------------------------------------------------------------------------

if R2 >= 0.90 && RMSE <= 1.0

    surrogateReliable = true;

    fprintf('\nSTATUS : SURROGATE MODEL ACCEPTED\n');

elseif R2 >= 0.75 && RMSE <= 2.0

    surrogateReliable = true;

    fprintf('\nSTATUS : SURROGATE MODEL ACCEPTED WITH CAUTION\n');

else

    surrogateReliable = false;

    fprintf('\nSTATUS : SURROGATE MODEL NOT RELIABLE\n');

end

%% ========================================================================
% 8B. SURROGATE VALIDATION PLOT
% =========================================================================

figure( ...
    'Name','Surrogate Validation',...
    'NumberTitle','off');

scatter( ...
    Y,...
    predictedTraining,...
    45,...
    'filled');

hold on;

minValue = ...
    min([Y;predictedTraining]);

maxValue = ...
    max([Y;predictedTraining]);

plot( ...
    [minValue maxValue],...
    [minValue maxValue],...
    '--',...
    'LineWidth',2);

grid on;

xlabel('Actual S_{11} (dB)');
ylabel('Predicted S_{11} (dB)');

title('Surrogate Model: Actual vs Predicted');

legend( ...
    'Training Samples',...
    'Ideal Prediction',...
    'Location','best');

saveas( ...
    gcf,...
    fullfile( ...
    resultFolder,...
    'Surrogate_Validation.png'));

%% ========================================================================
% 8C. CROSS-VALIDATION
% =========================================================================

fprintf('\nRunning leave-one-out validation...\n');

N = size(X,1);

LOOerror = NaN(N,1);

for i = 1:N

    trainingIndex = true(N,1);

    trainingIndex(i) = false;

    Xtrain = Xnorm(trainingIndex,:);
    Ytrain = Y(trainingIndex);

    Wtrain = Xtrain(:,1);
    Htrain = Xtrain(:,2);
    Ltrain = Xtrain(:,3);

    Atrain = [ ...
        ones(size(Wtrain)),...
        Wtrain,...
        Htrain,...
        Ltrain,...
        Wtrain.^2,...
        Htrain.^2,...
        Ltrain.^2,...
        Wtrain.*Htrain,...
        Wtrain.*Ltrain,...
        Htrain.*Ltrain];

    betaLOO = ...
        Atrain\Ytrain;

    %% Test point

    Wtest = Xnorm(i,1);
    Htest = Xnorm(i,2);
    Ltest = Xnorm(i,3);

    Atest = [ ...
        1,...
        Wtest,...
        Htest,...
        Ltest,...
        Wtest^2,...
        Htest^2,...
        Ltest^2,...
        Wtest*Htest,...
        Wtest*Ltest,...
        Htest*Ltest];

    prediction = ...
        Atest*betaLOO;

    LOOerror(i) = ...
        Y(i)-prediction;

end

%% Cross-validation metrics

LOO_RMSE = ...
    sqrt(mean(LOOerror.^2));

LOO_MAE = ...
    mean(abs(LOOerror));

fprintf('\nCross-validation results\n');
fprintf('-------------------------------------\n');

fprintf('LOO RMSE : %.4f dB\n',LOO_RMSE);
fprintf('LOO MAE  : %.4f dB\n',LOO_MAE);

if LOO_RMSE <= 1.5

    fprintf('Cross-validation : PASS\n');

else

    fprintf('Cross-validation : WARNING\n');

end
