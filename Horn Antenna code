%% ========================================================================
% 56. HIGH-EFFICIENCY ADAPTIVE HORN OPTIMIZATION
% =========================================================================

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('          HIGH-EFFICIENCY ADAPTIVE OPTIMIZATION\n');
fprintf('=====================================================================\n');

optimizationTimer = tic;

%% ========================================================================
% OPTIMIZATION SETTINGS
% =========================================================================

% Target frequency
targetFreq = f0;

% Maximum number of promising designs for detailed analysis
maxCandidates = 8;

% S11 threshold for expensive analysis
s11Threshold = -6;

%% ========================================================================
% STAGE 1 - COARSE SEARCH
% =========================================================================

coarseWidth  = 0.08:0.01:0.12;
coarseHeight = 0.05:0.01:0.09;
coarseLength = 0.10:0.02:0.20;

%% Generate all combinations

[CW,CH,CL] = ndgrid( ...
    coarseWidth,...
    coarseHeight,...
    coarseLength);

CW = CW(:);
CH = CH(:);
CL = CL(:);

numCoarse = numel(CW);

fprintf('\nCoarse designs : %d\n',numCoarse);

%% ========================================================================
% PREALLOCATE
% =========================================================================

coarseS11  = NaN(numCoarse,1);
coarseVSWR = NaN(numCoarse,1);

%% ========================================================================
% STAGE 1 - S11 SCREENING
% =========================================================================

fprintf('\nRunning S11 screening...\n');

% ---------------------------------------------------------
% Use PARFOR when Parallel Computing Toolbox is available
% ---------------------------------------------------------

useParallel = license('test','Distrib_Computing_Toolbox');

if useParallel

    fprintf('Parallel processing enabled.\n');

    parfor k = 1:numCoarse

        testHorn = horn;

        testHorn.FlareWidth  = CW(k);
        testHorn.FlareHeight = CH(k);
        testHorn.Length      = CL(k);

        try

            tempS = ...
                sparameters(testHorn,targetFreq);

            gamma = ...
                abs(tempS.Parameters(1,1));

            coarseS11(k) = ...
                20*log10(gamma);

            if gamma < 1

                coarseVSWR(k) = ...
                    (1+gamma)/(1-gamma);

            end

        catch

            coarseS11(k)  = NaN;
            coarseVSWR(k) = NaN;

        end

    end

else

    fprintf('Parallel toolbox unavailable. Using serial processing.\n');

    for k = 1:numCoarse

        testHorn = horn;

        testHorn.FlareWidth  = CW(k);
        testHorn.FlareHeight = CH(k);
        testHorn.Length      = CL(k);

        try

            tempS = ...
                sparameters(testHorn,targetFreq);

            gamma = ...
                abs(tempS.Parameters(1,1));

            coarseS11(k) = ...
                20*log10(gamma);

            if gamma < 1

                coarseVSWR(k) = ...
                    (1+gamma)/(1-gamma);

            end

        catch

            coarseS11(k)  = NaN;
            coarseVSWR(k) = NaN;

        end

    end

end

%% ========================================================================
% REMOVE INVALID RESULTS
% =========================================================================

valid = ...
    isfinite(coarseS11) & ...
    isfinite(coarseVSWR);

CW = CW(valid);
CH = CH(valid);
CL = CL(valid);

coarseS11  = coarseS11(valid);
coarseVSWR = coarseVSWR(valid);

%% ========================================================================
% FAST COARSE SCORE
% =========================================================================

coarseScore = zeros(size(coarseS11));

%% S11 contribution

coarseScore = ...
    coarseScore + ...
    min(50,max(0,-3*coarseS11));

%% VSWR contribution

coarseScore = ...
    coarseScore + ...
    min(30,max(0,30 - ...
    10*(coarseVSWR-1)));

%% Dimension stability contribution

dimensionPenalty = ...
    abs(CW-0.10)/0.10 + ...
    abs(CH-0.07)/0.07 + ...
    abs(CL-0.15)/0.15;

coarseScore = ...
    coarseScore + ...
    max(0,20-10*dimensionPenalty);

%% ========================================================================
% SELECT BEST COARSE DESIGNS
% =========================================================================

[~,rank] = ...
    sort(coarseScore,'descend');

candidateCount = ...
    min(maxCandidates,numel(rank));

candidateIndex = ...
    rank(1:candidateCount);

fprintf('\nValid designs       : %d\n',numel(CW));

fprintf('Detailed candidates : %d\n',candidateCount);

%% ========================================================================
% STAGE 2 - DETAILED ANALYSIS
% =========================================================================

fprintf('\nRunning detailed analysis...\n');

%% Preallocate

candidateS11 = NaN(candidateCount,1);
candidateVSWR = NaN(candidateCount,1);

candidateGain = NaN(candidateCount,1);
candidateDirectivity = NaN(candidateCount,1);

candidateWidth = NaN(candidateCount,1);
candidateHeight = NaN(candidateCount,1);
candidateLength = NaN(candidateCount,1);

%% ========================================================================
% DETAILED CANDIDATE ANALYSIS
% =========================================================================

if useParallel

    parfor n = 1:candidateCount

        k = candidateIndex(n);

        candidateWidth(n)  = CW(k);
        candidateHeight(n) = CH(k);
        candidateLength(n) = CL(k);

        candidateS11(n) = coarseS11(k);
        candidateVSWR(n) = coarseVSWR(k);

        % -----------------------------------------------------
        % Early rejection
        % -----------------------------------------------------

        if candidateS11(n) > s11Threshold

            continue;

        end

        testHorn = horn;

        testHorn.FlareWidth  = candidateWidth(n);
        testHorn.FlareHeight = candidateHeight(n);
        testHorn.Length      = candidateLength(n);

        % -----------------------------------------------------
        % Directivity
        % -----------------------------------------------------

        try

            candidateDirectivity(n) = ...
                pattern( ...
                testHorn,...
                targetFreq,...
                0,...
                0,...
                'Type','directivity');

        catch

            candidateDirectivity(n) = NaN;

        end

        % -----------------------------------------------------
        % Gain
        % -----------------------------------------------------

        try

            candidateGain(n) = ...
                pattern( ...
                testHorn,...
                targetFreq,...
                0,...
                0,...
                'Type','gain');

        catch

            candidateGain(n) = NaN;

        end

    end

else

    for n = 1:candidateCount

        k = candidateIndex(n);

        candidateWidth(n)  = CW(k);
        candidateHeight(n) = CH(k);
        candidateLength(n) = CL(k);

        candidateS11(n) = coarseS11(k);
        candidateVSWR(n) = coarseVSWR(k);

        if candidateS11(n) > s11Threshold

            continue;

        end

        testHorn = horn;

        testHorn.FlareWidth  = candidateWidth(n);
        testHorn.FlareHeight = candidateHeight(n);
        testHorn.Length      = candidateLength(n);

        try

            candidateDirectivity(n) = ...
                pattern( ...
                testHorn,...
                targetFreq,...
                0,...
                0,...
                'Type','directivity');

        catch

            candidateDirectivity(n) = NaN;

        end

        try

            candidateGain(n) = ...
                pattern( ...
                testHorn,...
                targetFreq,...
                0,...
                0,...
                'Type','gain');

        catch

            candidateGain(n) = NaN;

        end

    end

end

%% ========================================================================
% FINAL SCORE
% =========================================================================

candidateScore = zeros(candidateCount,1);

%% S11

candidateScore = ...
    candidateScore + ...
    min(40,max(0,-2*candidateS11));

%% VSWR

candidateScore = ...
    candidateScore + ...
    min(20,max(0,20-10*(candidateVSWR-1)));

%% Directivity

validDirectivity = ...
    isfinite(candidateDirectivity);

candidateScore(validDirectivity) = ...
    candidateScore(validDirectivity) + ...
    min(25,max(0,...
    candidateDirectivity(validDirectivity)));

%% Gain

validGain = ...
    isfinite(candidateGain);

candidateScore(validGain) = ...
    candidateScore(validGain) + ...
    min(15,max(0,...
    candidateGain(validGain)));

%% ========================================================================
% CREATE FINAL TABLE
% =========================================================================

optimizationTable = table( ...
    candidateWidth,...
    candidateHeight,...
    candidateLength,...
    candidateS11,...
    candidateVSWR,...
    candidateGain,...
    candidateDirectivity,...
    candidateScore,...
    'VariableNames',...
    { ...
    'FlareWidth_m',...
    'FlareHeight_m',...
    'HornLength_m',...
    'S11_dB',...
    'VSWR',...
    'Gain_dBi',...
    'Directivity_dBi',...
    'Score' ...
    });

%% ========================================================================
% REMOVE INVALID DESIGNS
% =========================================================================

optimizationTable = ...
    optimizationTable( ...
    isfinite(optimizationTable.Score),:);

%% ========================================================================
% SORT
% =========================================================================

optimizationTable = ...
    sortrows( ...
    optimizationTable,...
    'Score',...
    'descend');

%% ========================================================================
% BEST DESIGN
% =========================================================================

if ~isempty(optimizationTable)

    bestDesign = ...
        optimizationTable(1,:);

    fprintf('\n');
    fprintf('=====================================================================\n');
    fprintf('                    BEST DESIGN\n');
    fprintf('=====================================================================\n');

    fprintf('\nFlare Width  : %.3f cm\n',...
        bestDesign.FlareWidth_m*100);

    fprintf('Flare Height : %.3f cm\n',...
        bestDesign.FlareHeight_m*100);

    fprintf('Horn Length  : %.3f cm\n',...
        bestDesign.HornLength_m*100);

    fprintf('\nS11          : %.3f dB\n',...
        bestDesign.S11_dB);

    fprintf('VSWR         : %.3f\n',...
        bestDesign.VSWR);

    fprintf('Gain         : %.3f dBi\n',...
        bestDesign.Gain_dBi);

    fprintf('Directivity  : %.3f dBi\n',...
        bestDesign.Directivity_dBi);

    fprintf('Score        : %.2f / 100\n',...
        bestDesign.Score);

end

%% ========================================================================
% SAVE RESULTS
% =========================================================================

writetable( ...
    optimizationTable,...
    fullfile( ...
    resultFolder,...
    'Optimized_Designs.csv'));

%% ========================================================================
% TOP 5 DESIGNS
% =========================================================================

topN = ...
    min(5,height(optimizationTable));

topDesigns = ...
    optimizationTable(1:topN,:);

writetable( ...
    topDesigns,...
    fullfile( ...
    resultFolder,...
    'Top_5_Designs.csv'));

%% ========================================================================
% CREATE OPTIMIZED HORN
% =========================================================================

if ~isempty(optimizationTable)

    optimizedHorn = horn;

    optimizedHorn.FlareWidth = ...
        bestDesign.FlareWidth_m;

    optimizedHorn.FlareHeight = ...
        bestDesign.FlareHeight_m;

    optimizedHorn.Length = ...
        bestDesign.HornLength_m;

    %% -------------------------------------------------------------
    % Final S11 verification
    % --------------------------------------------------------------

    optimizedS = ...
        sparameters( ...
        optimizedHorn,...
        freqRange);

    optimizedS11 = ...
        squeeze(optimizedS.Parameters(1,1,:));

    optimizedS11dB = ...
        20*log10(abs(optimizedS11));

    %% -------------------------------------------------------------
    % Optimized geometry
    % --------------------------------------------------------------

    figure( ...
        'Name','Optimized Geometry',...
        'NumberTitle','off');

    show(optimizedHorn);

    title('Optimized Rectangular Horn');

    saveas( ...
        gcf,...
        fullfile( ...
        resultFolder,...
        'Optimized_Geometry.png'));

    %% -------------------------------------------------------------
    % Optimized radiation
    % --------------------------------------------------------------

    figure( ...
        'Name','Optimized Radiation',...
        'NumberTitle','off');

    pattern( ...
        optimizedHorn,...
        f0);

    title('Optimized Radiation Pattern at 10 GHz');

    saveas( ...
        gcf,...
        fullfile( ...
        resultFolder,...
        'Optimized_Radiation.png'));

    %% -------------------------------------------------------------
    % Original vs optimized S11
    % --------------------------------------------------------------

    figure( ...
        'Name','S11 Comparison',...
        'NumberTitle','off');

    plot( ...
        freqRange/1e9,...
        S11dB,...
        'LineWidth',2);

    hold on;

    plot( ...
        freqRange/1e9,...
        optimizedS11dB,...
        '--',...
        'LineWidth',2);

    yline(-10,':');

    grid on;

    xlabel('Frequency (GHz)');
    ylabel('S_{11} (dB)');

    title('Original vs Optimized S_{11}');

    legend( ...
        'Original',...
        'Optimized',...
        '-10 dB Target',...
        'Location','best');

    saveas( ...
        gcf,...
        fullfile( ...
        resultFolder,...
        'Original_vs_Optimized_S11.png'));

end

%% ========================================================================
% PERFORMANCE SUMMARY
% =========================================================================

optimizationTime = ...
    toc(optimizationTimer);

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('                 EFFICIENCY SUMMARY\n');
fprintf('=====================================================================\n');

fprintf('Total coarse designs       : %d\n',numCoarse);

fprintf('S11 simulations            : %d\n',numCoarse);

fprintf('Detailed candidates        : %d\n',candidateCount);

fprintf('S11 threshold              : %.1f dB\n',s11Threshold);

fprintf('Optimization execution     : %.2f seconds\n',...
    optimizationTime);

if useParallel

    fprintf('Execution mode             : PARALLEL\n');

else

    fprintf('Execution mode             : SERIAL\n');

end

fprintf('=====================================================================\n');
