%% ========================================================================
% 41. MULTI-PARAMETER HORN OPTIMIZATION
% ========================================================================

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('                 MULTI-PARAMETER OPTIMIZATION\n');
fprintf('=====================================================================\n');

%% Design variable ranges

widthValues = ...
    [0.08 0.09 0.10 0.11 0.12];

heightValues = ...
    [0.05 0.06 0.07 0.08 0.09];

lengthValues = ...
    [0.10 0.12 0.15 0.18 0.20];

totalDesigns = ...
    length(widthValues) * ...
    length(heightValues) * ...
    length(lengthValues);

fprintf('\nTotal designs to evaluate: %d\n',totalDesigns);

%% Storage

optimizationData = [];

designCounter = 0;

%% Optimization loop

for w = 1:length(widthValues)

    for h = 1:length(heightValues)

        for l = 1:length(lengthValues)

            designCounter = designCounter + 1;

            testWidth = widthValues(w);
            testHeight = heightValues(h);
            testLength = lengthValues(l);

            fprintf( ...
                '\nDesign %d / %d\n', ...
                designCounter,totalDesigns);

            fprintf( ...
                'Width = %.2f cm | Height = %.2f cm | Length = %.2f cm\n', ...
                testWidth*100, ...
                testHeight*100, ...
                testLength*100);

            %% Create test antenna

            testHorn = horn;

            testHorn.FlareWidth = testWidth;
            testHorn.FlareHeight = testHeight;
            testHorn.Length = testLength;

            %% S11 at target frequency

            try

                tempS = ...
                    sparameters(testHorn,f0);

                tempS11 = ...
                    squeeze(tempS.Parameters(1,1));

                tempS11dB = ...
                    20*log10(abs(tempS11));

            catch

                tempS11dB = NaN;

            end

            %% Directivity

            try

                tempDirectivity = ...
                    pattern( ...
                    testHorn, ...
                    f0, ...
                    0, ...
                    0, ...
                    'Type','directivity');

            catch

                tempDirectivity = NaN;

            end

            %% Gain

            try

                tempGain = ...
                    pattern( ...
                    testHorn, ...
                    f0, ...
                    0, ...
                    0, ...
                    'Type','gain');

            catch

                tempGain = NaN;

            end

            %% VSWR

            if ~isnan(tempS11dB)

                gammaTemp = ...
                    10^(tempS11dB/20);

                tempVSWR = ...
                    (1+gammaTemp)/(1-gammaTemp);

            else

                tempVSWR = NaN;

            end

            %% Design score

            tempScore = 0;

            % S11 score
            if ~isnan(tempS11dB)

                if tempS11dB <= -15

                    tempScore = tempScore + 40;

                elseif tempS11dB <= -10

                    tempScore = tempScore + 35;

                elseif tempS11dB <= -6

                    tempScore = tempScore + 25;

                elseif tempS11dB <= -3

                    tempScore = tempScore + 10;

                end

            end

            % Directivity score

            if ~isnan(tempDirectivity)

                if tempDirectivity >= 20

                    tempScore = tempScore + 30;

                elseif tempDirectivity >= 15

                    tempScore = tempScore + 25;

                elseif tempDirectivity >= 10

                    tempScore = tempScore + 15;

                end

            end

            % VSWR score

            if ~isnan(tempVSWR)

                if tempVSWR <= 1.5

                    tempScore = tempScore + 20;

                elseif tempVSWR <= 2

                    tempScore = tempScore + 15;

                elseif tempVSWR <= 3

                    tempScore = tempScore + 5;

                end

            end

            % Gain score

            if ~isnan(tempGain)

                if tempGain >= 15

                    tempScore = tempScore + 10;

                elseif tempGain >= 10

                    tempScore = tempScore + 5;

                end

            end

            %% Store

            optimizationData = [ ...
                optimizationData; ...
                testWidth ...
                testHeight ...
                testLength ...
                tempS11dB ...
                tempVSWR ...
                tempGain ...
                tempDirectivity ...
                tempScore];

        end

    end

end

%% ========================================================================
% 42. CONVERT OPTIMIZATION DATA TO TABLE
% ========================================================================

optimizationTable = table( ...
    optimizationData(:,1), ...
    optimizationData(:,2), ...
    optimizationData(:,3), ...
    optimizationData(:,4), ...
    optimizationData(:,5), ...
    optimizationData(:,6), ...
    optimizationData(:,7), ...
    optimizationData(:,8), ...
    'VariableNames', ...
    { ...
    'FlareWidth_m', ...
    'FlareHeight_m', ...
    'HornLength_m', ...
    'S11_dB', ...
    'VSWR', ...
    'Gain_dBi', ...
    'Directivity_dBi', ...
    'Score' ...
    });

%% ========================================================================
% 43. FIND BEST DESIGN
% ========================================================================

validScores = optimizationTable.Score;

[bestScore,bestIndex] = ...
    max(validScores);

bestDesign = ...
    optimizationTable(bestIndex,:);

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('                     OPTIMIZATION RESULT\n');
fprintf('=====================================================================\n');

fprintf('\nBest Design:\n');

fprintf('Flare Width  : %.2f cm\n',...
    bestDesign.FlareWidth_m*100);

fprintf('Flare Height : %.2f cm\n',...
    bestDesign.FlareHeight_m*100);

fprintf('Horn Length  : %.2f cm\n',...
    bestDesign.HornLength_m*100);

fprintf('S11          : %.2f dB\n',...
    bestDesign.S11_dB);

fprintf('VSWR         : %.2f\n',...
    bestDesign.VSWR);

fprintf('Gain         : %.2f dBi\n',...
    bestDesign.Gain_dBi);

fprintf('Directivity  : %.2f dBi\n',...
    bestDesign.Directivity_dBi);

fprintf('Score        : %.0f / 100\n',...
    bestDesign.Score);

%% ========================================================================
% 44. SAVE OPTIMIZATION TABLE
% ========================================================================

writetable( ...
    optimizationTable, ...
    fullfile( ...
    resultFolder, ...
    'Complete_Optimization_Results.csv'));

%% ========================================================================
% 45. CREATE OPTIMIZED ANTENNA
% ========================================================================

optimizedHorn = horn;

optimizedHorn.FlareWidth = ...
    bestDesign.FlareWidth_m;

optimizedHorn.FlareHeight = ...
    bestDesign.FlareHeight_m;

optimizedHorn.Length = ...
    bestDesign.HornLength_m;

%% ========================================================================
% 46. OPTIMIZED GEOMETRY
% ========================================================================

figure( ...
    'Name','Optimized Horn Geometry', ...
    'NumberTitle','off');

show(optimizedHorn);

title('Optimized Rectangular Horn Antenna');

saveas( ...
    gcf, ...
    fullfile( ...
    resultFolder, ...
    '40_Optimized_Geometry.png'));

%% ========================================================================
% 47. OPTIMIZED RADIATION PATTERN
% ========================================================================

figure( ...
    'Name','Optimized Radiation Pattern', ...
    'NumberTitle','off');

pattern( ...
    optimizedHorn, ...
    f0);

title('Optimized Horn Radiation Pattern at 10 GHz');

saveas( ...
    gcf, ...
    fullfile( ...
    resultFolder, ...
    '41_Optimized_Radiation_Pattern.png'));

%% ========================================================================
% 48. ORIGINAL VS OPTIMIZED S11
% ========================================================================

try

    optimizedS = ...
        sparameters( ...
        optimizedHorn, ...
        freqRange);

    optimizedS11 = ...
        squeeze( ...
        optimizedS.Parameters(1,1,:));

    optimizedS11dB = ...
        20*log10(abs(optimizedS11));

    figure( ...
        'Name','Original vs Optimized S11', ...
        'NumberTitle','off');

    plot( ...
        freqRange/1e9, ...
        S11dB, ...
        'LineWidth',2);

    hold on;

    plot( ...
        freqRange/1e9, ...
        optimizedS11dB, ...
        '--', ...
        'LineWidth',2);

    yline(-10,'--');

    grid on;

    xlabel('Frequency (GHz)');
    ylabel('S_{11} (dB)');

    title('Original vs Optimized Horn S_{11}');

    legend( ...
        'Original Design', ...
        'Optimized Design', ...
        '-10 dB Target', ...
        'Location','best');

    saveas( ...
        gcf, ...
        fullfile( ...
        resultFolder, ...
        '42_Original_vs_Optimized_S11.png'));

catch

    fprintf('Optimized S11 comparison unavailable.\n');

end

%% ========================================================================
% 49. OPTIMIZATION SCORE DISTRIBUTION
% ========================================================================

figure( ...
    'Name','Optimization Score', ...
    'NumberTitle','off');

histogram( ...
    optimizationTable.Score, ...
    15);

grid on;

xlabel('Design Score');
ylabel('Number of Designs');

title('Distribution of Optimization Scores');

saveas( ...
    gcf, ...
    fullfile( ...
    resultFolder, ...
    '43_Optimization_Score.png'));

%% ========================================================================
% 50. TOP 10 DESIGNS
% ========================================================================

sortedTable = ...
    sortrows( ...
    optimizationTable, ...
    'Score', ...
    'descend');

top10Count = ...
    min(10,height(sortedTable));

top10 = ...
    sortedTable(1:top10Count,:);

writetable( ...
    top10, ...
    fullfile( ...
    resultFolder, ...
    'Top_10_Designs.csv'));

fprintf('\n');
fprintf('Top %d designs exported.\n',top10Count);

%% ========================================================================
% 51. OPTIMIZATION SUMMARY
% ========================================================================

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('                    DESIGN RECOMMENDATION\n');
fprintf('=====================================================================\n');

if bestDesign.S11_dB <= -10

    fprintf('\nPASS: Optimized design reaches S11 <= -10 dB.\n');

else

    fprintf('\nWARNING: Optimized design does not reach -10 dB.\n');

end

if bestDesign.VSWR <= 2

    fprintf('PASS: Optimized design achieves VSWR <= 2.\n');

else

    fprintf('WARNING: VSWR remains above 2.\n');

end

if bestDesign.Directivity_dBi >= 15

    fprintf('PASS: Directivity exceeds 15 dBi.\n');

else

    fprintf('NOTE: Directivity can be further improved.\n');

end

fprintf('\nRecommended geometry:\n');

fprintf('Width  = %.2f cm\n',...
    bestDesign.FlareWidth_m*100);

fprintf('Height = %.2f cm\n',...
    bestDesign.FlareHeight_m*100);

fprintf('Length = %.2f cm\n',...
    bestDesign.HornLength_m*100);

%% ========================================================================
% 52. FINAL EXECUTION TIME
% ========================================================================

totalExecutionTime = toc(totalTimer);

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('TOTAL EXECUTION TIME : %.2f seconds\n',totalExecutionTime);
fprintf('=====================================================================\n');
