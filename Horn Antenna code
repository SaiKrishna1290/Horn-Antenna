%% ========================================================================
% 41. HIGH-EFFICIENCY MULTI-PARAMETER OPTIMIZATION
% =========================================================================

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('             HIGH-EFFICIENCY HORN OPTIMIZATION\n');
fprintf('=====================================================================\n');

optimizationTimer = tic;

%% ------------------------------------------------------------------------
% DESIGN VARIABLES
% -------------------------------------------------------------------------

widthValues  = [0.08 0.09 0.10 0.11 0.12];
heightValues = [0.05 0.06 0.07 0.08 0.09];
lengthValues = [0.10 0.12 0.15 0.18 0.20];

nW = numel(widthValues);
nH = numel(heightValues);
nL = numel(lengthValues);

totalDesigns = nW*nH*nL;

fprintf('\nTotal candidate designs : %d\n',totalDesigns);

%% ------------------------------------------------------------------------
% CREATE ALL DESIGN COMBINATIONS
% -------------------------------------------------------------------------

[W,H,L] = ndgrid( ...
    widthValues, ...
    heightValues, ...
    lengthValues);

W = W(:);
H = H(:);
L = L(:);

%% ------------------------------------------------------------------------
% PREALLOCATE RESULTS
% -------------------------------------------------------------------------

S11Result = NaN(totalDesigns,1);
VSWRResult = NaN(totalDesigns,1);

GainResult = NaN(totalDesigns,1);
DirectivityResult = NaN(totalDesigns,1);

Score = zeros(totalDesigns,1);

%% ------------------------------------------------------------------------
% STAGE 1
% S11-BASED SCREENING
%
% Only calculate S11 for all designs.
% Expensive radiation-pattern calculations are postponed.
% -------------------------------------------------------------------------

fprintf('\nStage 1: S11 screening...\n');

for k = 1:totalDesigns

    testHorn = horn;

    testHorn.FlareWidth  = W(k);
    testHorn.FlareHeight = H(k);
    testHorn.Length      = L(k);

    try

        tempS = sparameters(testHorn,f0);

        tempS11 = ...
            squeeze(tempS.Parameters(1,1));

        S11Result(k) = ...
            20*log10(abs(tempS11));

        %% VSWR

        gamma = abs(tempS11);

        if gamma < 1

            VSWRResult(k) = ...
                (1 + gamma)/(1 - gamma);

        end

    catch

        S11Result(k) = NaN;
        VSWRResult(k) = NaN;

    end

end

%% ------------------------------------------------------------------------
% IDENTIFY BEST S11 CANDIDATES
% -------------------------------------------------------------------------

valid = ~isnan(S11Result);

validIndices = find(valid);

[~,sortIndex] = ...
    sort(S11Result(validIndices),'ascend');

sortedIndices = ...
    validIndices(sortIndex);

%% ------------------------------------------------------------------------
% NUMBER OF DESIGNS TO ANALYZE IN STAGE 2
% -------------------------------------------------------------------------

numCandidates = min(15,numel(sortedIndices));

candidateIndices = ...
    sortedIndices(1:numCandidates);

fprintf('\nStage 1 complete.\n');

fprintf('Valid designs       : %d\n',sum(valid));

fprintf('Stage-2 candidates  : %d\n',numCandidates);

fprintf('Skipped expensive calculations for %d designs.\n',...
    totalDesigns-numCandidates);

%% ------------------------------------------------------------------------
% STAGE 2
% DETAILED EM ANALYSIS ONLY FOR BEST CANDIDATES
% -------------------------------------------------------------------------

fprintf('\nStage 2: Gain and directivity analysis...\n');

for n = 1:numCandidates

    k = candidateIndices(n);

    fprintf( ...
        'Analyzing candidate %d/%d\n',...
        n,numCandidates);

    testHorn = horn;

    testHorn.FlareWidth  = W(k);
    testHorn.FlareHeight = H(k);
    testHorn.Length      = L(k);

    %% Directivity

    try

        DirectivityResult(k) = ...
            pattern( ...
            testHorn,...
            f0,...
            0,...
            0,...
            'Type','directivity');

    catch

        DirectivityResult(k) = NaN;

    end

    %% Gain

    try

        GainResult(k) = ...
            pattern( ...
            testHorn,...
            f0,...
            0,...
            0,...
            'Type','gain');

    catch

        GainResult(k) = NaN;

    end

end

%% ========================================================================
% 42. FAST DESIGN SCORING
% =========================================================================

fprintf('\nCalculating design scores...\n');

%% S11 score

Score(S11Result <= -15) = ...
    Score(S11Result <= -15) + 40;

Score(S11Result > -15 & ...
      S11Result <= -10) = ...
    Score(S11Result > -15 & ...
          S11Result <= -10) + 35;

Score(S11Result > -10 & ...
      S11Result <= -6) = ...
    Score(S11Result > -10 & ...
          S11Result <= -6) + 25;

Score(S11Result > -6 & ...
      S11Result <= -3) = ...
    Score(S11Result > -6 & ...
          S11Result <= -3) + 10;

%% Directivity score

Score(DirectivityResult >= 20) = ...
    Score(DirectivityResult >= 20) + 30;

Score(DirectivityResult >= 15 & ...
      DirectivityResult < 20) = ...
    Score(DirectivityResult >= 15 & ...
          DirectivityResult < 20) + 25;

Score(DirectivityResult >= 10 & ...
      DirectivityResult < 15) = ...
    Score(DirectivityResult >= 10 & ...
          DirectivityResult < 15) + 15;

%% VSWR score

Score(VSWRResult <= 1.5) = ...
    Score(VSWRResult <= 1.5) + 20;

Score(VSWRResult > 1.5 & ...
      VSWRResult <= 2) = ...
    Score(VSWRResult > 1.5 & ...
          VSWRResult <= 2) + 15;

Score(VSWRResult > 2 & ...
      VSWRResult <= 3) = ...
    Score(VSWRResult > 2 & ...
          VSWRResult <= 3) + 5;

%% Gain score

Score(GainResult >= 15) = ...
    Score(GainResult >= 15) + 10;

Score(GainResult >= 10 & ...
      GainResult < 15) = ...
    Score(GainResult >= 10 & ...
          GainResult < 15) + 5;

%% ========================================================================
% 43. CREATE RESULT TABLE DIRECTLY
% =========================================================================

optimizationTable = table( ...
    W,...
    H,...
    L,...
    S11Result,...
    VSWRResult,...
    GainResult,...
    DirectivityResult,...
    Score,...
    'VariableNames',...
    { ...
    'FlareWidth_m',...
    'FlareHeight_m',...
    'HornLength_m',...
    'S11_dB',...
    'VSWR',...
    'Gain_dBi',...
    'Directivity_dBi',...
    'Score' ...
    });

%% ========================================================================
% 44. REMOVE INVALID DESIGNS
% =========================================================================

optimizationTable = ...
    optimizationTable( ...
    ~isnan(optimizationTable.S11_dB),:);

%% ========================================================================
% 45. SORT DESIGNS
% =========================================================================

optimizationTable = ...
    sortrows( ...
    optimizationTable,...
    'Score',...
    'descend');

%% ========================================================================
% 46. BEST DESIGN
% =========================================================================

bestDesign = ...
    optimizationTable(1,:);

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('                     BEST DESIGN FOUND\n');
fprintf('=====================================================================\n');

fprintf('\nWidth       : %.2f cm\n',...
    bestDesign.FlareWidth_m*100);

fprintf('Height      : %.2f cm\n',...
    bestDesign.FlareHeight_m*100);

fprintf('Length      : %.2f cm\n',...
    bestDesign.HornLength_m*100);

fprintf('\nS11         : %.2f dB\n',...
    bestDesign.S11_dB);

fprintf('VSWR        : %.3f\n',...
    bestDesign.VSWR);

fprintf('Gain        : %.2f dBi\n',...
    bestDesign.Gain_dBi);

fprintf('Directivity : %.2f dBi\n',...
    bestDesign.Directivity_dBi);

fprintf('Score       : %.0f / 100\n',...
    bestDesign.Score);

%% ========================================================================
% 47. SAVE COMPLETE OPTIMIZATION RESULTS
% =========================================================================

writetable( ...
    optimizationTable,...
    fullfile( ...
    resultFolder,...
    'Optimized_Horn_Results.csv'));

%% ========================================================================
% 48. TOP 10 DESIGNS
% =========================================================================

topN = min(10,height(optimizationTable));

top10 = ...
    optimizationTable(1:topN,:);

writetable( ...
    top10,...
    fullfile( ...
    resultFolder,...
    'Top_10_Horn_Designs.csv'));

%% ========================================================================
% 49. CREATE BEST ANTENNA
% =========================================================================

optimizedHorn = horn;

optimizedHorn.FlareWidth = ...
    bestDesign.FlareWidth_m;

optimizedHorn.FlareHeight = ...
    bestDesign.FlareHeight_m;

optimizedHorn.Length = ...
    bestDesign.HornLength_m;

%% ========================================================================
% 50. VERIFY OPTIMIZED DESIGN
% =========================================================================

fprintf('\nVerifying optimized antenna...\n');

optimizedS = ...
    sparameters( ...
    optimizedHorn,...
    freqRange);

optimizedS11 = ...
    squeeze(optimizedS.Parameters(1,1,:));

optimizedS11dB = ...
    20*log10(abs(optimizedS11));

%% ========================================================================
% 51. ORIGINAL VS OPTIMIZED S11
% =========================================================================

figure( ...
    'Name','Original vs Optimized S11',...
    'NumberTitle','off');

plot( ...
    freqRange/1e9,...
    S11dB,...
    'LineWidth',2);

hold on;

plot( ...
    freqRange/1e9,...
    optimizedS11dB,...
    '--',...
    'LineWidth',2);

yline( ...
    -10,...
    ':');

grid on;

xlabel('Frequency (GHz)');
ylabel('S_{11} (dB)');

title('Original vs Optimized Horn');

legend( ...
    'Original',...
    'Optimized',...
    '-10 dB Target',...
    'Location','best');

saveas( ...
    gcf,...
    fullfile( ...
    resultFolder,...
    'Optimized_vs_Original_S11.png'));

%% ========================================================================
% 52. OPTIMIZED GEOMETRY
% =========================================================================

figure( ...
    'Name','Optimized Horn Geometry',...
    'NumberTitle','off');

show(optimizedHorn);

title('Optimized Rectangular Horn Antenna');

saveas( ...
    gcf,...
    fullfile( ...
    resultFolder,...
    'Optimized_Geometry.png'));

%% ========================================================================
% 53. OPTIMIZED RADIATION PATTERN
% =========================================================================

figure( ...
    'Name','Optimized Radiation Pattern',...
    'NumberTitle','off');

pattern( ...
    optimizedHorn,...
    f0);

title('Optimized Horn Radiation Pattern at 10 GHz');

saveas( ...
    gcf,...
    fullfile( ...
    resultFolder,...
    'Optimized_Radiation_Pattern.png'));

%% ========================================================================
% 54. OPTIMIZATION SCORE GRAPH
% =========================================================================

figure( ...
    'Name','Optimization Scores',...
    'NumberTitle','off');

numPlot = ...
    min(20,height(optimizationTable));

bar( ...
    optimizationTable.Score(1:numPlot));

grid on;

xlabel('Design Rank');
ylabel('Score');

title('Top Horn Design Scores');

saveas( ...
    gcf,...
    fullfile( ...
    resultFolder,...
    'Optimization_Scores.png'));

%% ========================================================================
% 55. OPTIMIZATION TIME
% =========================================================================

optimizationTime = toc(optimizationTimer);

fprintf('\n');
fprintf('=====================================================================\n');
fprintf('                    OPTIMIZATION SUMMARY\n');
fprintf('=====================================================================\n');

fprintf('Total Designs          : %d\n',totalDesigns);

fprintf('S11 Calculations       : %d\n',totalDesigns);

fprintf('Detailed EM Analyses   : %d\n',numCandidates);

fprintf('Skipped Detailed Runs  : %d\n',...
    totalDesigns-numCandidates);

fprintf('Optimization Time      : %.2f seconds\n',...
    optimizationTime);

fprintf('=====================================================================\n');
